# Ignore system-specific files
.DS_Store
Thumbs.db

# Ignore local configuration files
*.env

# Ignore SQL Server-related files
*.mdf
*.ldf
*.ndf

# Ignore temporary or backup files
*.log
*.bak
*.tmp

# Ignore IDE-specific files
.vscode/
.idea/

# Ignore stray exported data / diagrams, but keep the project's own
# source datasets, documentation images, and dbt seeds.
*.csv
!datasets/**/*.csv
!dbt_project/seeds/**/*.csv
*.png
!docs/**/*.png
*.pdf
!docs/**/*.pdf

# dbt
dbt_project/profiles.yml
dbt_project/target/
dbt_project/dbt_packages/
dbt_project/logs/
dbt_project/.venv/
dbt_project/.user.yml
*.duckdb
*.duckdb.wal
